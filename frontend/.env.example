# ─────────────────────────────────────────────────
# TrendStock AI — Frontend Environment Variables
# ─────────────────────────────────────────────────
# Copy this file to .env and adjust if needed:
#   cp .env.example .env
# Vite requires the VITE_ prefix for browser-accessible variables.
# ─────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api
